{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "bigeastbot",
  "server": {},
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["site.api.espn.com"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "[BigEastBot] Update sidebar now",
        "description": "Re-check the season opener and refresh the sidebar and widgets.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/update-now"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "update-sidebar": {
        "endpoint": "/internal/cron/update-sidebar",
        "cron": "*/5 * * * *"
      }
    }
  },
  "dev": {
    "subreddit": "jives00test"
  },
  "scripts": {
    "dev": "npm run watch"
  }
}
